<odoo>
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="author"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_borrow" string="Ijaraga berish"
                            type="object" class="btn-primary"
                            invisible="state != 'available'"/>
                    <button name="action_return" string="Qaytarish"
                            type="object" class="btn-primary"
                            invisible="state != 'borrowed'"/>
                    <button name="action_lost" string="Yo'qolgan deb belgilash"
                            type="object"
                            invisible="state == 'lost'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="isbn"/>
                        <field name="publish_date"/>
                        <field name="pages"/>
                        <field name="state"/>
                        <field name="librarian_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Kitoblar</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_root" name="Kutubxona"/>
    <menuitem id="menu_library_book" name="Kitoblar"
              parent="menu_library_root" action="action_library_book"/>
</odoo>